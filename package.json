{
  "name": "sluggit",
  "version": "2.0.0",
  "description": "A lightweight and fast utility for generating URL-friendly slugs in TypeScript with unicode, locale, and uniqueness support.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/misbahul-alam/sluggit#readme",
  "bugs": {
    "url": "https://github.com/misbahul-alam/sluggit/issues"
  },
  "repository": {
    "url": "git+https://github.com/misbahul-alam/sluggit.git",
    "type": "git"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "slug",
    "sluggit",
    "text",
    "string",
    "typescript",
    "url",
    "utility"
  ],
  "author": "Misbahul Alam",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
